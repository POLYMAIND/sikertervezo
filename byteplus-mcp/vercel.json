{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/mcp/:token", "destination": "/api/mcp?token=:token" },
    { "source": "/mcp", "destination": "/api/mcp" }
  ],
  "functions": {
    "api/mcp.js": { "maxDuration": 60 }
  }
}
