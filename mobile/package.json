{
  "name": "sikermaker-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Sikermaker iOS-app (Capacitor): a public/ mappa az appba csomagolva, az API a https://sikermaker.hu-n.",
  "scripts": {
    "www": "node scripts/build-www.mjs",
    "sync": "node scripts/build-www.mjs && cap sync ios",
    "icons": "capacitor-assets generate --ios --iconBackgroundColor '#1F2024' --splashBackgroundColor '#1F2024'",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@supabase/supabase-js": "2.45.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2"
  }
}
