# Sikermaker — környezeti változók. Vercelen állítsd be, NE a repóban. Üresen: bemutató mód (belépés nélkül).

# --- Supabase (saját projekt, EU-régió) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=            # nyilvános kulcs, a böngésző is megkapja (RLS véd)
SUPABASE_SERVICE_ROLE_KEY=    # TITKOS, csak szerver-oldal (márkák, PolyOS-kapcsolatok)

# --- márkák ---
DEFAULT_BRAND=alap            # ha nincs ?brand= és nincs domain-hozzárendelés
BRAND_HOSTS={}                # pl. {"tervezo.ceged.hu":"ceged"} — white label saját domainen
APP_URL=                      # az app nyilvános címe, pl. https://tervezo.pelda.hu (élesben kötelező)

# --- jogi oldalak (regisztrációs űrlap linkjei) ---
TERMS_URL=
PRIVACY_URL=

# --- PolyOS-híd (a PolyOS-ben regisztrált „sikertervezo" kliens adatai) ---
POLYOS_PUBLIC_URL=https://www.polyos.hu
POLYOS_API_BASE=
POLYOS_CLIENT_ID=
POLYOS_CLIENT_SECRET=         # TITKOS
LINK_ENC_KEY=                 # TITKOS, 32 bájt base64: openssl rand -base64 32

# --- csak fejlesztéshez (élesben hatástalan) ---
POLYOS_MOCK=                  # 1 = a PolyOS-hívások szimulálva
POLYOS_MOCK_MODULES=crm,projects,calendar

# --- Pro e-mail (Brevo) ---
BREVO_API_KEY=                # TITKOS: Brevo → SMTP & API → API kulcsok
EMAIL_FROM=                   # a Brevóban hitelesített feladó, pl. Sikermaker <tervezo@polymaind.hu>

# --- Polymaind PolyOS CRM: minden regisztráló a „Sikermaker regisztrálók" pipeline-ba ---
POLYOS_CRM_WEBHOOK_URL=https://www.polyos.hu/api/newsletter/webhooks/site
POLYOS_CRM_WEBHOOK_SECRET=    # TITKOS: a PolyOS adja ki (Email marketing → Weboldal-feliratkozás, POLYOS egység)
CRON_SECRET=                  # TITKOS: a napi /api/crm-sync védelme (a Vercel cron automatikusan küldi)

# --- Számlázz.hu: magyar számla minden sikeres Stripe-fizetésről (invoice.paid) ---
SZAMLAZZ_AGENT_KEY=           # TITKOS: Számlázz.hu → Beállítások → Számla Agent kulcs
SZAMLAZZ_AFAKULCS=27          # 27, vagy alanyi adómentesnél AAM
SZAMLAZZ_ELOTAG=              # opcionális számlaszám-előtag (a Számlázz.hu-ban előbb fel kell venni)
SZAMLAZZ_REPLYTO=hello@polymaind.hu   # a számla-e-mailre adott válasz ide megy
SZAMLAZZ_TETEL_NEV=Sikermaker Pro előfizetés
